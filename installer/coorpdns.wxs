<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="CoorpDNS Endpoint Agent"
           Language="1033"
           Version="1.0.0"
           Manufacturer="TI Plus Solucoes"
           UpgradeCode="4f9c5d12-3e2a-4b71-8c90-7d3e2b1a9f4c">

    <Package Description="CoorpDNS Endpoint Protection Agent for Windows"
             Comments="Instalador Corporativo CoorpDNS (DoH Shield)"
             InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine" />

    <Media Id="1" Cabinet="coorpdns.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="CoorpDNS">
          <Component Id="AgentBinary" Guid="a1b2c3d4-e5f6-4a5b-8c7d-9e0f1a2b3c4d">
            <File Id="CoorpdnsAgentExe" Source="/docker/coorpdns/coorpdns-agent.exe" KeyPath="yes" />
          </Component>
          <Component Id="AgentLauncher" Guid="b2c3d4e5-f6a7-4b5c-8d7e-0f1a2b3c4d5e">
            <File Id="StartAgentBat" Source="/docker/coorpdns/build_msi/iniciar.bat" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="CoorpDNS Agent" Level="1">
      <ComponentRef Id="AgentBinary" />
      <ComponentRef Id="AgentLauncher" />
    </Feature>
  </Product>
</Wix>
